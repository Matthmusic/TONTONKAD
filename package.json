{
  "name": "tontonkad",
  "version": "2.7.1",
  "description": "TONTONKAD - Dimensionnement de chemins de câbles et fourreaux",
  "main": "src/main/main.js",
  "author": "TONTONKAD Team",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dev:web": "vite",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "release": "electron-builder --publish always",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "bmad:refresh": "bmad-method install -f -i codex",
    "bmad:list": "bmad-method list:agents",
    "bmad:validate": "bmad-method validate"
  },
  "keywords": [
    "electrical",
    "engineering",
    "cables",
    "conduits",
    "design",
    "CAD"
  ],
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "electron": "^39.2.0",
    "electron-builder": "^26.0.12",
    "jest": "^25.0.0",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0-alpha.3",
    "dxf-writer": "^1.18.4",
    "electron-updater": "^6.6.2",
    "interactjs": "^1.10.27",
    "konva": "^10.2.3",
    "maxrects-packer": "2.7.3"
  },
  "build": {
    "appId": "com.tontonkad.app",
    "productName": "TONTONKAD",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "data/**/*",
      "assets/**/*",
      "ico/**/*"
    ],
    "extraResources": [
      {
        "from": "data",
        "to": "data",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "publish": [
        "github"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TONTONKAD",
      "installerSidebar": "installerSidebar.bmp"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icons/ico/icon.icns",
      "category": "public.app-category.productivity",
      "publish": [
        "github"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icons/ico",
      "category": "Engineering",
      "publish": [
        "github"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "Matthmusic",
      "repo": "TONTONKAD"
    }
  }
}
